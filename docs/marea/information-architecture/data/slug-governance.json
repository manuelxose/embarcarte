  "governanceSemantics": "These rules govern how a slug may be derived and validated for the proposed layer. They do not authorize creating, publishing or redirecting any URL. Existing indexed slugs are frozen and are recorded, not renamed.",
  "slugModel": "A canonical slug is the final path segment of a public route. It is stored without a leading or trailing slash and without query string or fragment. Identity belongs to entityId and routeId; the slug is only the locale-specific locator.",
  "normalizationPipeline": [
    "1. Strip query string and fragment (SG-019) and decode exactly once (SG-024).",
    "2. Apply Unicode NFC (SG-001).",
    "3. If the segment belongs to the frozen current-route registry, stop and keep it verbatim (SG-004).",
    "4. Otherwise lowercase ASCII (SG-002) and transliterate diacritics to ASCII (SG-003).",
    "5. Replace separator characters with a single hyphen and collapse repeats (SG-005, SG-009).",
    "6. Reject any remaining character outside [a-z0-9-] (SG-006, SG-007).",
    "7. Validate length (SG-010), reserved segments (SG-011, SG-025), namespace uniqueness (SG-012), locale mapping (SG-015 to SG-018) and claim language (SG-026).",
    "8. Bind the accepted slug to exactly one entityId and one routeId (SG-028)."
  ],
  "namespaceModel": {
    "definition": "A slug namespace is the parent path plus the locale. /marea/[family] and /marea/soluciones/[bundle] are separate namespaces, so the same slug value may exist in both.",
    "namespaces": [
      "root (corporate pages)",
      "root/en (localized corporate pages)",
      "marea",
      "en/marea",
      "marea/productos and en/marea/products (family namespace)",
      "marea/soluciones and en/marea/solutions (bundle namespace)",
      "soporte/marea and en/support/marea (documentation namespace)",
      "admin (private, never governed as public slugs)"
    ],
    "violation": "Two different entities with the same slug in the same namespace and locale is a hard rejection (SG-012). The reverse case, one slug value in two namespaces, is allowed only when both bindings are declared in this file (SG-013)."
  },
