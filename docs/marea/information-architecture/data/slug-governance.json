  "items": [
    {
      "ruleId": "SG-001",
      "rule": "Every candidate slug must be normalized to Unicode NFC before comparison, hashing or storage; two slugs that differ only by canonical composition are the same slug.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "NFC",
      "testId": "SG-001-NFC-NORMALIZATION",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-002",
      "rule": "Canonical new slugs are ASCII lowercase; no locale-dependent casing rules may be applied (for example Turkish dotless i must not change a slug).",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "ASCII_LOWERCASE",
      "testId": "SG-002-ASCII-LOWERCASE",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-003",
      "rule": "Diacritics are transliterated to ASCII for NEW proposed slugs only: a-acute to a, e-acute to e, i-acute to i, o-acute to o, u-acute and u-diaeresis to u, n-tilde to n, c-cedilla to c. A new slug may never keep a non-ASCII character.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "ASCII_TRANSLITERATION",
      "testId": "SG-003-ASCII-TRANSLITERATION",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-004",
      "rule": "Existing indexed slugs recorded in src/app/core/i18n/locale-routes.ts are immutable byte for byte, including any accented or non-ASCII form. They are never re-normalized, transliterated or lowercased by this governance, and they never move.",
      "appliesTo": "EXISTING_INDEXED_SLUG",
      "normalization": "NONE_VERBATIM",
      "testId": "SG-004-EXISTING-SLUG-IMMUTABLE",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-005",
      "rule": "Words inside a slug are separated by exactly one hyphen. Underscores, spaces, plus signs, dots, camelCase and concatenated words without a separator are rejected.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "HYPHEN_SEPARATOR",
      "testId": "SG-005-HYPHEN-SEPARATOR",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-006",
      "rule": "A canonical slug contains only the characters a-z, 0-9 and hyphen. Every other character is a rejection, not a substitution, except for the diacritic transliteration allowed by SG-003.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "ALLOWED_CHARSET_A_Z_0_9_HYPHEN",
      "testId": "SG-006-ALLOWED-CHARSET",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-007",
      "rule": "No canonical slug may contain a space, punctuation mark, percent sign or percent-encoded sequence. Encoding is a transport concern applied once at link generation, never part of the stored identity.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "NO_PUNCTUATION_NO_PERCENT_ENCODING",
      "testId": "SG-007-NO-PUNCTUATION-NO-PERCENT",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-008",
      "rule": "A stored slug never begins or ends with a slash and never contains an empty segment. Path assembly is owned by the route registry, not by the slug value.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "TRIM_EDGE_SLASHES",
      "testId": "SG-008-NO-EDGE-SLASH",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-009",
      "rule": "A slug never starts or ends with a hyphen and never contains two consecutive hyphens.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "COLLAPSE_AND_TRIM_HYPHENS",
      "testId": "SG-009-HYPHEN-POSITION",
      "severity": "MEDIUM"
    },
    {
      "ruleId": "SG-010",
      "rule": "A slug is at most 60 characters. The limit is an internal design objective for readability and linking, not a search-engine requirement.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "MAX_LENGTH_60",
      "testId": "SG-010-MAX-LENGTH",
      "severity": "LOW"
    },
    {
      "ruleId": "SG-011",
      "rule": "No new slug may equal a segment listed in reservedSegments at the same position. Reservation is per position: productos is reserved at the root because of the legacy redirect and also reserved inside /marea for the products overview.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "RESERVED_SEGMENT_CHECK",
      "testId": "SG-011-RESERVED-SEGMENT",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-012",
      "rule": "Two different entities may never share a slug inside the same namespace and locale. A duplicate is rejected at registration, not merged, suffixed or auto-disambiguated.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "UNIQUE_PER_NAMESPACE_AND_LOCALE",
      "testId": "SG-012-DUPLICATE-REJECT",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-013",
      "rule": "Reusing one slug value across two declared namespaces is allowed only when both bindings appear in this file. Currently declared: fleet for ENT-FAMILY-FLEET under /marea and ENT-BUNDLE-FLEET under /marea/soluciones.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "DECLARED_NAMESPACE_REUSE",
      "testId": "SG-013-NAMESPACE-REUSE-DECLARED",
      "severity": "MEDIUM"
    },
    {
      "ruleId": "SG-014",
      "rule": "Entity identity is the entityId plus edition and bundle ids from the product and bundle data; it never depends on a locale display name. Renaming a display name in ES or EN does not change the entity and does not change any slug.",
      "appliesTo": "ENTITY_SLUG",
      "normalization": "IDENTITY_INDEPENDENT_OF_DISPLAY_NAME",
      "testId": "SG-014-ENTITY-IDENTITY-STABLE",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-015",
      "rule": "ES and EN slugs differ only where an explicit mapping exists in entitySlug or surfaceSlug. No slug may be produced by translating, transliterating or guessing the other locale.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "EXPLICIT_LOCALE_MAPPING_ONLY",
      "testId": "SG-015-EXPLICIT-LOCALE-MAPPING",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-016",
      "rule": "No EN slug is invented where no approved EN translation of the page exists. The page is then ES-only, emits no EN alternate and receives no hreflang pair.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "NO_EN_SLUG_WITHOUT_TRANSLATION",
      "testId": "SG-016-NO-INVENTED-EN-SLUG",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-017",
      "rule": "An edition slug is derived deterministically from editionId: lowercased and hyphen-separated, so NAV-PRO becomes nav-pro and DISPLAY-LARGE-CONDITIONAL becomes display-large-conditional. Edition slugs are technical and documentation locators and are not independent public routes in MC-15.",
      "appliesTo": "EDITION_SLUG",
      "normalization": "EDITION_ID_LOWERCASE_HYPHEN",
      "testId": "SG-017-EDITION-SLUG-DERIVATION",
      "severity": "MEDIUM"
    },
    {
      "ruleId": "SG-018",
      "rule": "Bundle slugs come from the closed enumeration START, CRUISE, SAIL, PROTECT, COMPLETE, FLEET, lowercased. The bundle path segment is literal: no open :slug parameter exists in the bundle namespace, so a new bundle requires a registry decision, not a new slug.",
      "appliesTo": "BUNDLE_SLUG",
      "normalization": "CLOSED_BUNDLE_ENUMERATION",
      "testId": "SG-018-BUNDLE-SLUG-ENUMERATION",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-019",
      "rule": "Query string and fragment are never part of entity identity. They are stripped before matching and are preserved only as presentation state by the language switcher.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "STRIP_QUERY_AND_FRAGMENT",
      "testId": "SG-019-QUERY-FRAGMENT-STRIPPED",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-020",
      "rule": "Private identifiers such as order id, customer id, product database id and admin route ids never appear in a public slug. Private routes are never indexed and never enter the slug map.",
      "appliesTo": "PRIVATE_ROUTE",
      "normalization": "PRIVATE_ID_EXCLUSION",
