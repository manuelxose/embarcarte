      "normalization": "DECODE_ONCE",
      "testId": "SG-024-DECODE-ONCE",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-025",
      "rule": "Technical first segments served by the application are reserved and may never be a page slug: api, uploads, healthz, readyz, sitemap.xml, robots.txt, favicon.ico, favicon.svg, site.webmanifest, images, assets, static.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "TECHNICAL_TOKEN_RESERVED",
      "testId": "SG-025-TECHNICAL-TOKEN-RESERVED",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-026",
      "rule": "A slug may not encode commercial state or a claim: buy, comprar, price, precio, stock, disponible, available, certified, certificado, oferta, cheap are prohibited as slug words.",
      "appliesTo": "NEW_PROPOSED_SLUG",
      "normalization": "NO_CLAIM_LANGUAGE",
      "testId": "SG-026-NO-CLAIM-LANGUAGE",
      "severity": "HIGH"
    },
    {
      "ruleId": "SG-027",
      "rule": "The locale prefix en/ belongs to the EN path only. An ES slug never begins with en, and an EN pattern always begins with en/ after the leading slash. The bare segment en is reserved at the root.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "LOCALE_PREFIX_OWNERSHIP",
      "testId": "SG-027-LOCALE-PREFIX",
      "severity": "BLOCKER"
    },
    {
      "ruleId": "SG-028",
      "rule": "Every accepted slug resolves to exactly one entityId and one routeId in the proposed registries. An orphan slug with no entity binding, or one slug bound to two entities in one namespace, is rejected.",
      "appliesTo": "ALL_SLUGS",
      "normalization": "SLUG_ENTITY_BINDING",
