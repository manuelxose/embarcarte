# Copia este fichero a /opt/embarcarte/.env en el servidor (chmod 600).
SITE_URL=https://embarcarte.com

# Administrador del panel /admin. Se crea (o se le restablece la contraseña) al arrancar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (formulario de contacto y avisos de pedidos). Sin SMTP_HOST solo se registran en los logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=web@embarcarte.com
CONTACT_TO=info@embarcarte.com

# Pago con tarjeta (opcional). Sin estas claves, la tienda acepta pedidos por transferencia.
# Webhook en Stripe: https://embarcarte.com/api/stripe/webhook, evento checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
